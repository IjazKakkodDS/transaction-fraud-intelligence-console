# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://fraud_user:fraud_pass@postgres:5432/fraud_db

# Fraud scoring thresholds (optional — defaults applied if not set)
MODEL_WEIGHT=0.6
RULE_WEIGHT=0.4
REVIEW_THRESHOLD=0.3
BLOCK_THRESHOLD=0.7

# Model artifact
MODEL_PATH=saved_models/fraud_model.pkl

# Kafka / Redpanda event broker (Phase 2)
# Inside Docker Compose:  KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
# Running on host machine: KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Leave unset to disable event publishing (API continues to work normally).
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092

# Dual-path retirement flag (see docs/dual_path_retirement_plan.md).
# true  — POST /predict scores synchronously and returns the result directly
#         (current Phase 2 behavior; two Postgres rows per transaction).
# false — POST /predict publishes only and returns HTTP 202 Accepted;
#         scoring-consumer is the sole scorer (one Postgres row per transaction).
# Do NOT set to false until GET /predictions/{transaction_id} is deployed.
SYNC_SCORING_ENABLED=true

# LLM reasoning layer (Phase 3) — local Ollama
# Ollama must be running on the host machine (docker.internal resolves to the host from inside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=300

# n8n workflow automation (Phase 4)
# Set to the n8n webhook URL to enable POST /workflow/notify-case/{case_id}.
# Example: N8N_WEBHOOK_URL=http://localhost:5678/webhook/fraud-case
N8N_WEBHOOK_URL=

# Portfolio Risk Scan (Phase 12)
# Safe local defaults. Raise deliberately for benchmark runs only.
# RISK_SCAN_MAX_ROWS controls the accepted upload row cap.
# RISK_SCAN_CHUNK_SIZE controls async scoring/persistence batch size.
# RISK_SCAN_EXPORT_BATCH_SIZE controls server-side CSV export cursor fetch size.
RISK_SCAN_MAX_ROWS=50000
RISK_SCAN_CHUNK_SIZE=500
RISK_SCAN_EXPORT_BATCH_SIZE=10000
