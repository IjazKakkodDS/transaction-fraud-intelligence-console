# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://fraud_user:fraud_pass@postgres:5432/fraud_db

# Fraud scoring thresholds (optional — defaults applied if not set)
MODEL_WEIGHT=0.6
RULE_WEIGHT=0.4
REVIEW_THRESHOLD=0.3
BLOCK_THRESHOLD=0.7

# Model artifact
MODEL_PATH=saved_models/fraud_model.pkl

# Kafka / Redpanda event broker (Phase 2)
# Inside Docker Compose:  KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
# Running on host machine: KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Leave unset to disable event publishing (API continues to work normally).
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092

# Dual-path retirement flag (see docs/dual_path_retirement_plan.md).
# true  — POST /predict scores synchronously and returns the result directly
#         (current Phase 2 behavior; two Postgres rows per transaction).
# false — POST /predict publishes only and returns HTTP 202 Accepted;
#         scoring-consumer is the sole scorer (one Postgres row per transaction).
# Do NOT set to false until GET /predictions/{transaction_id} is deployed.
SYNC_SCORING_ENABLED=true
